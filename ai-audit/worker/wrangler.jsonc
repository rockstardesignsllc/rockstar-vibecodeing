{
	"name": "rockstar-ai-audit",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [
			{ "name": "AUDIT_SESSIONS", "class_name": "AuditSession" },
			{ "name": "DEMO_SESSIONS", "class_name": "DemoSession" },
			{ "name": "DEALER_COACH", "class_name": "DealerCoach" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["AuditSession"] },
		{ "tag": "v2", "new_sqlite_classes": ["DemoSession"] },
		{ "tag": "v3", "new_sqlite_classes": ["DealerCoach"] }
	],
	"ratelimits": [
		// New audits per visitor IP, per minute
		{ "name": "START_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
		// Chat messages per visitor IP, per minute
		{ "name": "MESSAGE_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
	],
	// The BDC demo page is bundled as text and served by GET /demo/embed.js
	"rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
	"vars": {
		// Comma separated origins allowed to run the audit and the BDC demo: the HighLevel page that holds the embed, and its preview domain
		"ALLOWED_ORIGINS": "https://aiaudit.rockstarinfo.com,https://app.rockstarinfo.com,https://rockstarinfo.com,https://www.rockstarinfo.com,https://getrockstarai.com,https://www.getrockstarai.com,https://bdcdemo.aifordealers.com,https://aifordealers.com,https://www.aifordealers.com",
		"BOOKING_URL": "https://app.rockstarinfo.com/widget/bookings/rockstarai",
		"HIGHLEVEL_LOCATION_ID": "hrsRmtnUmvqCKm3d01tx",
		"MODEL": "claude-sonnet-5-5",
		"COACH_BASE_URL": "https://rockstar-ai-audit.rockstar-designs-llc.workers.dev",
		"COACH_APP_URL": "https://app.rockstarinfo.com"
	}
}
